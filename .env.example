OPENAI_API_KEY=1
GITHUB_TOKEN=1
GITHUB_OWNER=1
GITHUB_REPO=你的repo名字
AWS_PROFILE=default
AWS_REGION=1
PGHOST=your-supabase-pooler-host
PGPORT=5432
PGDATABASE=postgres
PGUSER=your-pooler-user
PGPASSWORD=your-database-password
